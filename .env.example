# getbarber.app — environment variables
# Copy to .env.local and fill in real values.

# ── App
NEXT_PUBLIC_APP_URL=https://getbarber.app
NEXT_PUBLIC_DEFAULT_LOCALE=es
NEXT_PUBLIC_USE_MOCK_DATA=true

# ── Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Stripe (Edwin's account → SaaS billing for shop owners)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Connect (for barbers' Express accounts)
STRIPE_CONNECT_CLIENT_ID=ca_...

# ── Twilio (SMS + WhatsApp via Content API)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_MESSAGING_SERVICE_SID=MG...
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ── Cron secret (Vercel Cron uses this to authenticate)
CRON_SECRET=change-me-to-a-random-string
